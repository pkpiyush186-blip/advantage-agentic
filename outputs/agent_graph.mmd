graph TD;
	__start__([<p>__start__</p>]):::first
	s1_pull(s1_pull)
	s2_validate(s2_validate)
	exception(exception)
	s3_propose(s3_propose)
	s4_guardrail(s4_guardrail)
	s5_route(s5_route)
	await_manager(await_manager)
